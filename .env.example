# Optional Docker Compose overrides. Do not put secrets here.

# Host ports published by docker-compose.yml.
SPARGE_PRODUCER_PORT=3051
SPARGE_OBSERVER_PORT=3052

# Required for docker-compose.production.yml.
# Use a real DNS name pointing to the deployment server.
SPARGE_DOMAIN=explorer.example.com

# Useful runtime overrides if you create a custom compose override file.
LOG_FORMAT=json
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false

# Production Caddy deployments should trust exactly one proxy hop.
SECURITY_TRUST_PROXY=1
CORS_ALLOW_ORIGINS=https://explorer.example.com

# Private operator dashboard. Keep disabled unless using localhost/VPN/SSH tunnel.
OPERATOR_DASHBOARD_ENABLED=false
OPERATOR_DASHBOARD_LOCAL_ONLY=true

# Optional off-chain Discord community identity. Disabled by default.
COMMUNITY_IDENTITY_ENABLED=false
COMMUNITY_PUBLIC_BASE_URL=https://explorer.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OAUTH_REDIRECT_URI=https://explorer.example.com/api/community/discord/callback
COMMUNITY_ROLE_SYNC_ENABLED=true
