{
  "name": "sparge-chain",
  "version": "0.1.4-alpha.0",
  "description": "Sparge chain producer and observer node",
  "author": "SpargeNetwork",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "observer:desktop": "electron electron/main.js",
    "wallet": "node scripts/wallet.js",
    "tx": "node scripts/tx.js",
    "mine:start": "node scripts/mine.js start",
    "mine:stop": "node scripts/mine.js stop",
    "mine:status": "node scripts/mine.js status",
    "test:stability": "powershell -ExecutionPolicy Bypass -File scripts/test-stability.ps1",
    "test:network": "node scripts/test-network.js",
    "snapshot:state": "powershell -ExecutionPolicy Bypass -File scripts/snapshot-state.ps1",
    "restore:state": "powershell -ExecutionPolicy Bypass -File scripts/restore-state.ps1",
    "backup": "node scripts/backup.js create",
    "restore": "node scripts/backup.js restore",
    "backup:verify": "node scripts/backup.js verify",
    "replay": "node scripts/replay.js",
    "repair:balance-history": "node scripts/repair-balance-history.js",
    "ops:healthwatch": "powershell -ExecutionPolicy Bypass -File scripts/watch-health.ps1",
    "test:recovery": "powershell -ExecutionPolicy Bypass -File scripts/test-recovery.ps1",
    "test:economics": "node scripts/test-economics.js",
    "test:participant-maturation": "node scripts/test-participant-maturation.js",
    "test:participant-ui-docs": "node scripts/test-participant-ui-docs.js",
    "test:community-identity": "node scripts/test-community-identity.js",
    "test:validation": "node scripts/test-validation.js",
    "test:request-size": "node scripts/test-request-size.js",
    "test:rate-limits": "node scripts/test-rate-limits.js",
    "test:mempool": "node scripts/test-mempool.js",
    "test:invariants": "node scripts/test-invariants.js",
    "test:logging": "node scripts/test-logging.js",
    "test:operator-dashboard": "node scripts/test-operator-dashboard.js",
    "test:wallet-ui": "node scripts/test-wallet-ui.js",
    "test:site-layout": "node scripts/test-site-layout.js",
    "test:observer-onboarding": "node scripts/test-observer-onboarding.js",
    "test:observer-updater": "node scripts/test-observer-updater.js",
    "test:explorer-homepage": "node scripts/test-explorer-homepage.js",
    "test:explorer-tx": "node scripts/test-explorer-tx.js",
    "test:backup": "node scripts/test-backup.js",
    "test:replay": "node scripts/test-replay.js",
    "rebuild:node18": "node scripts/rebuild-sqlite.js",
    "rebuild:node20": "node scripts/rebuild-sqlite20.js",
    "build:observer:win": "node scripts/build-observer.js",
    "prepare:electron:runtime": "node scripts/prepare-electron-runtime.js",
    "generate:icon": "node scripts/generate-icon.js",
    "dist:observer:win": "npm run build:observer:win && npm run prepare:electron:runtime && npm run generate:icon && electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.5",
    "bs58": "^5.0.0",
    "electron-updater": "^6.6.2",
    "express": "^4.19.2",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "io.sparge.observer",
    "productName": "Sparge Observer",
    "artifactName": "Sparge-Observer-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "SpargeNetwork",
        "repo": "sparge-node",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron/runtime",
        "to": "observer-runtime"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "pkg": {
    "assets": [
      "public/*.html",
      "public/*.js",
      "public/*.css",
      "public/assets/**/*",
      "config/config.yml"
    ]
  }
}
