<%- include('../partials/header', { title: 'Goods Receipts', userId: userId }) %>
<div class="toolbar">
  <h1>Goods Receipts</h1>
  <a class="button" href="/receipts/new">New Receipt</a>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Delivery Note</th>
      <th>PO</th>
      <th>Status</th>
      <th>Date</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% receipts.forEach(r => { %>
      <tr>
        <td><%= r.deliveryNoteNo %></td>
        <td><%= r.purchaseOrder.poNumber %></td>
        <td>
          <span class="badge badge-status-<%= r.purchaseOrder.status.toLowerCase() %>"><%= r.purchaseOrder.statusLabel %></span>
        </td>
        <td><%= r.receivedAt ? r.receivedAt.toISOString().slice(0,10) : (r.createdAt ? r.createdAt.toISOString().slice(0,10) : '-') %></td>
        <td class="actions">
          <a href="/receipts/<%= r.id %>">View</a>
          <a href="/receipts/<%= r.id %>/edit">Edit</a>
          <form method="post" action="/receipts/<%= r.id %>/delete" onsubmit="return confirm('Delete receipt?');">
            <button type="submit" class="link">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
