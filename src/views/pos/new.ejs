<%- include('../partials/header', { title: 'New Purchase Order', userId: userId }) %>
<div class="card">
  <h1>New Purchase Order</h1>
  <form method="post" action="/pos" class="form">
    <label>PO Number
      <input type="text" name="poNumber" />
      <span class="hint">Leave empty to auto-generate (PO-0001).</span>
    </label>
    <label>Supplier
      <select name="supplierId" required>
        <% suppliers.forEach(supplier => { %>
          <option value="<%= supplier.id %>"><%= supplier.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Order Date
      <input type="date" name="orderDate" value="<%= today %>" required />
    </label>
    <label>Transport Cost (EUR, optional)
      <input type="number" step="0.01" name="transportCost" value="0" />
    </label>
    <button type="submit">Create</button>
  </form>
</div>
<%- include('../partials/footer') %>
