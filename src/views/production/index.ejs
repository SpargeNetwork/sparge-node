<%- include('../partials/header', { title: 'Production Batches', userId: userId }) %>
<div class="toolbar">
  <h1>Production Batches</h1>
  <a class="button" href="/production/new">New Batch</a>
</div>
<table class="table">
  <thead>
    <tr>
      <th>Batch</th>
      <th>BOM</th>
      <th>Finished Item</th>
      <th>Produced</th>
      <th>Date</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% batches.forEach(batch => { %>
      <tr>
        <td><%= batch.batchNumber %></td>
        <td><%= batch.bom.name %></td>
        <td><%= batch.item.name %></td>
        <td><%= batch.producedQty %> <%= batch.producedUnit %></td>
        <td><%= batch.createdAt.toISOString().slice(0,10) %></td>
        <td class="actions">
          <form method="post" action="/production/<%= batch.id %>/delete" onsubmit="return confirm('Delete batch and reverse stock?');">
            <button type="submit" class="link">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
