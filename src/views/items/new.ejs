<%- include('../partials/header', { title: 'New Item', userId: userId }) %>
<div class="card">
  <h1>New Item</h1>
  <form method="post" action="/items" class="form">
    <label>SKU
      <input type="text" name="sku" />
      <span class="hint">Leave empty for parent items to auto-generate a GRP SKU.</span>
    </label>
    <label>Name
      <input type="text" name="name" required />
    </label>
    <label>Category
      <input type="text" name="category" />
    </label>
    <label>Manufacturer
      <input type="text" name="manufacturer" />
    </label>
    <label>Purchase Price (EUR)
      <input type="number" step="0.01" name="purchasePrice" value="0" required />
    </label>
    <label>Parent Item
      <select name="parentItemId">
        <option value="">(None)</option>
        <% parentItems.forEach(parent => { %>
          <option value="<%= parent.id %>"><%= parent.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Supplier
      <select name="supplierId">
        <option value="">(Optional)</option>
        <% suppliers.forEach(supplier => { %>
          <option value="<%= supplier.id %>"><%= supplier.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Base Unit
      <select name="baseUnit" required>
        <option value="kg">kg</option>
        <option value="g">g</option>
        <option value="L">L</option>
        <option value="ml">ml</option>
        <option value="pcs">pcs</option>
      </select>
    </label>
    <label>Allowed Decimals
      <input type="number" name="allowedDecimals" value="2" min="0" max="6" required />
    </label>
    <label>Minimum Stock
      <input type="number" step="any" name="minStock" value="0" required />
    </label>
    <button type="submit">Create</button>
  </form>
</div>
<%- include('../partials/footer') %>
